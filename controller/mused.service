[Unit]
Description=mused - Muse Bridge controller daemon (VM-side front for the VPS relay)
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/home/hatch/.local/bin/mused
WorkingDirectory=/home/hatch
Environment=HOME=/home/hatch
Environment=PYTHONPATH=/home/hatch/.local/lib
EnvironmentFile=/home/hatch/.config/mused/proxy.env
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
StandardOutput=append:/home/hatch/workspace/logs/mused-systemd.log
StandardError=append:/home/hatch/workspace/logs/mused-systemd.log

[Install]
WantedBy=default.target
