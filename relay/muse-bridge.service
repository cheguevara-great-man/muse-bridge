[Unit]
Description=Muse Bridge VPS relay (authenticates and routes, executes nothing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/muse-bridge/muse-bridge.py
Restart=on-failure
RestartSec=3
Environment=MUSE_BRIDGE_LISTEN=127.0.0.1:8471
Environment=MUSE_BRIDGE_CONTROLLERS=/etc/muse-bridge/controllers.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
